# =============================================================================
#  Orbit — Environment Configuration Template
#  Copy to .env and fill in your values:  cp .env.example .env
# =============================================================================

# ── Release ──────────────────────────────────────────────────────────────────
ORBIT_VERSION=latest

# ── Ports  (all must be in range 5000-6000) ──────────────────────────────────
ORBIT_PORT=5000
ORBIT_MCP_PORT=5001
ORBIT_METRICS_PORT=5002

# ── Security ──────────────────────────────────────────────────────────────────
# Generate a strong secret:  openssl rand -hex 32
ORBIT_SECRET_KEY=change-me-generate-with-openssl-rand-hex-32

# ── TLS ───────────────────────────────────────────────────────────────────────
# Leave blank to use Orbit's auto-generated self-signed certificate.
ORBIT_TLS_CERT_FILE=
ORBIT_TLS_KEY_FILE=

# ── Domain ────────────────────────────────────────────────────────────────────
# Used by the Nginx profile for Let's Encrypt / reverse proxy
ORBIT_DOMAIN=orbit.example.com
